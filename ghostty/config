# Theme (matches tmux + nvim)
theme = TokyoNight Night

# Font
font-family = "CaskaydiaCove Nerd Font"
font-size = 13
font-thicken = true
font-thicken-strength = 1

# Cursor
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
mouse-hide-while-typing = true
# 1.4 turned select-to-copy off by default on macOS; this keeps the 1.3 behaviour
copy-on-select = primary

# Shell: always land in tmux (attach to the last session, or start "main")
command = /bin/zsh --login -c "tmux attach 2>/dev/null || tmux new-session -s main"

# Left Option sends Alt (fzf Alt-C, nvim <A-j>/<A-k>); right Option still types special chars
macos-option-as-alt = left

# Window
macos-titlebar-style = transparent
# Opaque, no blur: the macOS glass blur hides background-image (below)
background-opacity = 1
window-save-state = always
maximize = true
confirm-close-surface = false
quick-terminal-position = center

# Background image, shuffled from ~/Wallpapers by shuffle-bg.sh into wallpaper.conf (gitignored)
background-image-fit = cover
background-image-opacity = 0.08
config-file = ?wallpaper.conf

# Animated aurora behind the text (only tints empty background; pauses when unfocused). Disabled for now.
# custom-shader = shaders/aurora.glsl

# Padding (left, right, top, bottom → x/y in Ghostty)
window-padding-x = 4,0
window-padding-y = 2,0

# Keybinds (Ctrl+Enter / Shift+Enter CSI u sequences)
keybind = ctrl+enter=text:\x1b[13;5u
keybind = shift+enter=text:\x1b[13;2u

# Ctrl+` toggles a scratch terminal popup, like VS Code (sends tmux prefix C-a + t; see tmux/popup.sh)
keybind = ctrl+backquote=text:\x01t

# Cmd+Shift+B: queue the next background image (sends tmux prefix C-a + B), then reload to show one.
# Text must come before reload_config: text chained after a reload reads the freed old config (garbage bytes on quick presses).
keybind = cmd+shift+b=text:\x01B
keybind = chain=reload_config
