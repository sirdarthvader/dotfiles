# Theme
theme = nord
background = #282c35

# Font
font-size = 13
font-thicken = true
font-thicken-strength = 1

# Cursor
cursor-style = block
cursor-style-blink = false
cursor-color = #A3BE8C
shell-integration-features = no-cursor
mouse-hide-while-typing = true

# Shell
# command = zsh --login -c "if command -v tmux >/dev/null 2>&1; then tmux attach || tmux; else zsh; fi"

# Window
macos-titlebar-style = transparent
background-opacity = 0.70
background-blur = macos-glass-regular
window-save-state = always
maximize = true
confirm-close-surface = false
quick-terminal-position = center

# Padding (left, right, top, bottom → x/y in Ghostty)
window-padding-x = 4,0
window-padding-y = 2,0

# Keybinds (Ctrl+Enter / Shift+Enter CSI u sequences)
keybind = ctrl+enter=text:\x1b[13;5u
keybind = shift+enter=text:\x1b[13;2u
